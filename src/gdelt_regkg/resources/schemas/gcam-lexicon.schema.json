{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GCAM counts and weighted scores",
  "type": "object",
  "required": ["name", "dimensions"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key"],
        "oneOf": [
          {"required": ["words"], "properties": {"key": {"pattern": "^c"}}, "not": {"anyOf": [{"required": ["scores"]}, {"required": ["patterns"]}, {"required": ["theme"]}, {"required": ["tokenization"]}, {"required": ["emit_count"]}]}},
          {"required": ["patterns"], "properties": {"key": {"pattern": "^c"}}, "not": {"anyOf": [{"required": ["scores"]}, {"required": ["words"]}, {"required": ["theme"]}, {"required": ["tokenization"]}, {"required": ["emit_count"]}]}},
          {"required": ["scores"], "properties": {"key": {"pattern": "^v"}}, "not": {"anyOf": [{"required": ["words"]}, {"required": ["patterns"]}, {"required": ["theme"]}, {"required": ["lemmatization"]}]}},
          {"required": ["theme"], "properties": {"key": {"pattern": "^c"}}, "not": {"anyOf": [{"required": ["words"]}, {"required": ["patterns"]}, {"required": ["scores"]}, {"required": ["tokenization"]}, {"required": ["lemmatization"]}, {"required": ["emit_count"]}]}}
        ],
        "properties": {
          "key": {"type": "string", "pattern": "^[cv][1-9][0-9]*\\.[1-9][0-9]*$"},
          "category": {"type": "string"},
          "language": {"type": "string", "pattern": "^[a-z]{3}$", "default": "eng"},
          "words": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "patterns": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "scores": {"type": "object", "propertyNames": {"minLength": 1}, "additionalProperties": {"type": "number"}},
          "tokenization": {"enum": ["words", "whitespace"]},
          "emit_count": {"type": "boolean", "default": true},
          "lemmatization": {"const": "wordnet"},
          "theme": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "exceptions": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
    "exclusions": {"type": "object", "propertyNames": {"pattern": "^[1-9][0-9]*$"}, "additionalProperties": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}},
    "theme_rules": {"type": "array", "items": {"type": "object", "required": ["theme", "phrase"]}}
  }
}
