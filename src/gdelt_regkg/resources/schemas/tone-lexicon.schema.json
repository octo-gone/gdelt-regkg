{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reconstruct GKG tone lexicon v1",
  "description": "Structural validation of tone dictionaries. ToneLexicon validates token support after Unicode normalization.",
  "type": "object",
  "required": [
    "name",
    "positive",
    "negative",
    "activity",
    "self_group"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "positive": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "negative": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "activity": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "self_group": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  },
  "additionalProperties": true
}
