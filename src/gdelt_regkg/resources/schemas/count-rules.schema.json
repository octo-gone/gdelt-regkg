{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reconstruct GKG count rules v1",
  "description": "Editor and structural validation. Load with the library for semantic validation, including unique rule IDs and phrase compilation.",
  "type": "object",
  "required": [
    "schema",
    "name",
    "settings",
    "rules"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional editor schema reference."
    },
    "schema": {
      "const": "reconstruct-gkg/count-rules/v1"
    },
    "name": {
      "type": "string",
      "pattern": "\\S"
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "object_nouns",
        "auxiliaries",
        "unsafe_phrases",
        "unsafe_suffixes",
        "bad_object_words"
      ],
      "properties": {
        "object_nouns": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z]+(?:[' -][a-zA-Z]+)*$"
          }
        },
        "auxiliaries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z]+(?:[' -][a-zA-Z]+)*$"
          }
        },
        "unsafe_phrases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z]+(?:[' -][a-zA-Z]+)*$"
          }
        },
        "unsafe_suffixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z]+(?:[' -][a-zA-Z]+)*$"
          }
        },
        "bad_object_words": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-zA-Z]+(?:[' -][a-zA-Z]+)*$"
          }
        },
        "max_object_modifiers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20,
          "default": 3
        },
        "context_words": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        },
        "allow_bare_active": {
          "type": "boolean",
          "default": false
        },
        "reject_time_objects": {
          "type": "boolean",
          "default": false
        },
        "empty_object_nouns": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-zA-Z]+(?:[' -][a-zA-Z]+)*$"},
          "default": []
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "expression",
        "labels",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "predicate",
            "active_predicate",
            "template"
          ]
        },
        "expression": {
          "type": "string",
          "pattern": "^(?=[\\s\\S]*\\S)[^\\t\\r\\n]+$"
        },
        "labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]*$"
          }
        },
        "status": {
          "enum": [
            "enabled",
            "needs_review",
            "disabled"
          ]
        },
        "provenance": {
          "type": "object"
        },
        "aliases": false,
        "requires_all": false,
        "exclude_any": false
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "enabled"
              },
              "kind": {
                "enum": [
                  "predicate",
                  "active_predicate"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "expression": {
                "type": "string",
                "pattern": "^[a-zA-Z]+(?:[' -][a-zA-Z]+)*$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "enabled"
              },
              "kind": {
                "const": "template"
              }
            }
          },
          "then": {
            "properties": {
              "expression": {
                "type": "string",
                "pattern": "^[^{}#;\\t\\r\\n]*\\{number\\}[^{}#;\\t\\r\\n]*$"
              }
            }
          }
        }
      ]
    }
  }
}
